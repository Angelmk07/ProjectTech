  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Yesterday, people complained that things were too difficult and boring\u2014and
    that finding randomly placed posters wasn't even a challenge anymore. Fine, then!
    Instead of the usual \"injections,\" I\u2019ll scatter pages from my diary all
    over the place. Good luck trying to make any sense of my rants! And as for the
    poster needed to activate the mechanism\u2014I\u2019m going to tear it to pieces
    and hang the fragments up separately. THERE\u2019S YOUR QUEST, DAMMIT!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
