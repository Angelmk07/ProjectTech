      m_Calls: []
  title: 
  text: "What kind of half-wit hung this poster here? The diagram isn\u2019t even
    the right size. I\u2019m pretty sure I saw the correct one in Block A. And what
    about the bridge diagram in Block B? It\u2019s simple\u2014just red and blue
    in the corners\u2014but it\u2019s still necessary, isn\u2019t it?"
  disableWhileReading: []
  onNoteOpened:
    m_PersistentCalls:
      m_Calls: []
  onNoteClosed:
