  onInteracted:
    m_PersistentCalls:
      m_Calls: []
  title: 
  text: "Why is this damn purple lamp here again instead of the green one? I\u2019ve
    said and written it a hundred times: that damn piece of paper posted on the second
    section of this unit is wrong\u2014it\u2019s actually for the bridge in Unit
    B.\nAnd yes, I was the one who tore it. I don\u2019t remember exactly where the
    purple lamp was supposed to go, but it definitely wasn\u2019t in the same row
    as the blue and red ones."
  disableWhileReading: []
  onNoteOpened:
    m_PersistentCalls:
      m_Calls: []
  onNoteClosed:
    m_PersistentCalls:
      m_Calls: []
